DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ENV=production
ALLOWED_HOSTS=your-domain.com,localhost

POSTGRES_DB=klub51
POSTGRES_USER=klub51
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=https://your-domain.com

# OTP settings
OTP_TTL_MINUTES=10

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@klub51.app

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_CERTIFICATE_KEY=

# SSO / OIDC (optional)
SSO_OIDC_ISSUER=
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_AUTH_ENDPOINT=
SSO_OIDC_TOKEN_ENDPOINT=
SSO_OIDC_REDIRECT_URI=
SSO_OIDC_SCOPES=openid email profile
